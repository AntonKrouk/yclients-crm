# Reverse-proxy на приложение (порт 3020). Положить в /etc/nginx/sites-available/yclients-crm
# и слинковать в sites-enabled. Домен заменить на свой (напр. crm.babochka.com).
# HTTPS-строки добавит certbot автоматически (см. DEPLOY.md).

server {
    listen 80;
    server_name crm.babochka.com;   # <-- ваш домен/поддомен

    location / {
        proxy_pass http://127.0.0.1:3020;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
