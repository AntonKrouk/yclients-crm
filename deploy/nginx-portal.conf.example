# Клиентская запись (portal/server.js, порт 3021) на ОТДЕЛЬНОМ домене — без слова «crm».
# Положить в /etc/nginx/sites-available/yclients-portal, слинковать в sites-enabled,
# домен заменить на выбранный, HTTPS добавит certbot.

server {
    listen 80;
    server_name zapis.example.ru;   # <-- домен для клиентов

    client_max_body_size 32k;       # в портал ходят только маленькие JSON

    location / {
        proxy_pass http://127.0.0.1:3021;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
