# --- YClients API ---
# Партнёрский (application) токен — из личного кабинета разработчика YClients
YCLIENTS_PARTNER_TOKEN=
# Пользовательский токен администратора (user token), получается при авторизации
YCLIENTS_USER_TOKEN=
# ID филиала (company_id). Для нескольких филиалов — через запятую, каждый в виде id или id:Название,
# напр.: YCLIENTS_COMPANY_ID=387958:Басков,898298:Мытнинская  (названия можно опустить — подтянутся из API)
YCLIENTS_COMPANY_ID=
# Автовход (как в «Портных»): вместо USER_TOKEN можно задать логин+пароль администратора —
# сервер сам получит токен при старте и будет перелогиниваться при необходимости.
YCLIENTS_LOGIN=
YCLIENTS_PASSWORD=
# Боевой режим включается при PARTNER_TOKEN + COMPANY_ID + (USER_TOKEN ИЛИ LOGIN+PASSWORD).
# Иначе — ДЕМО-режим на сгенерированных данных.

# --- Безопасность (ОБЯЗАТЕЛЬНО на публичном сервере) ---
# Пароль для входа в дашборд. Пока пусто — вход открыт (только для локальной разработки).
# На VPS ОБЯЗАТЕЛЬНО задайте — иначе данные клиентов будут доступны всем.
DASHBOARD_PASSWORD=
# Секрет для подписи сессионной куки (любая длинная случайная строка). Если пусто — берётся из пароля.
SESSION_SECRET=
# Секрет для авто-синка по крону: позволяет POST /api/sync?token=... без входа.
CRON_SECRET=

# --- Telegram уведомления (опционально) ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# chat_id администраторов через запятую (узнать: бот получает /start, затем /getUpdates)
TELEGRAM_ADMIN_CHATS=
# Публичный адрес дашборда — добавляется в уведомление ссылкой
PUBLIC_URL=

# --- Прочее ---
PORT=3020
# Каталог для базы SQLite (на Timeweb — persistent volume, напр. /data)
DATA_DIR=./data
# Вкладка «ДР»: показываем только тех, кто был в салоне начиная с этого года.
# Ушедшие раньше в календарь именинников не попадают. По умолчанию 2024.
BIRTHDAY_ACTIVE_SINCE_YEAR=2024

# --- YandexGPT (вкладка «Скрипты», генерация текстов) ---
# Идентификатор каталога Yandex Cloud (виден в адресной строке консоли, не секрет)
YC_FOLDER_ID=
# API-ключ сервисного аккаунта с ролью ai.languageModels.user.
# Консоль → IAM → Сервисные аккаунты → Создать новый ключ → API-ключ,
# область действия yc.ai.languageModels.execute. Показывается ОДИН раз.
YC_API_KEY=
